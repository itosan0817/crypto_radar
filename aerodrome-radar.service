[Unit]
Description=Aerodrome Radar Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=itosaku
Group=itosaku
WorkingDirectory=/home/itosaku/crypto_radar/backend
Environment=PYTHONIOENCODING=utf-8
Environment=LANG=en_US.UTF-8
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/itosaku/crypto_radar/backend/venv/bin/python /home/itosaku/crypto_radar/backend/aerodrome_radar.py
Restart=always
RestartSec=10
StandardOutput=append:/home/itosaku/crypto_radar/backend/radar.log
StandardError=append:/home/itosaku/crypto_radar/backend/radar.log

[Install]
WantedBy=multi-user.target
